{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": "  "
  },
  "modules": [
    "title",
    "break",
    {
      "type": "command",
      "key": "Image",
      "text": "/usr/bin/ublue-image-info.sh"
    },
    {
      "type": "os",
      "key": "OS",
      "format": "{pretty-name}"
    },
    {
      "type": "kernel",
      "key": "Kernel"
    },
    {
      "type": "uptime",
      "key": "Uptime"
    },
    "break",
    {
      "type": "de",
      "key": "Desktop"
    },
    {
      "type": "cpu",
      "key": "CPU"
    },
    {
      "type": "gpu",
      "key": "GPU"
    },
    {
      "type": "memory",
      "key": "Memory"
    },
    {
      "type": "disk",
      "key": "Disk",
      "folders": "/var"
    },
    "break",
    "colors"
  ]
}
